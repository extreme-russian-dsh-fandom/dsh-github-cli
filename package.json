{
  "name": "dsh-github-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read and manage GitHub repositories, files, branches, pull requests, and issues through the authenticated GitHub CLI (gh), with local git support for clones, checkouts, and repository extraction.",
  "license": "BSD-2-Clause",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "gh.js",
    "read.js",
    "pr.js",
    "review.js",
    "issue.js",
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"test/unit/*.test.mjs\"",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
